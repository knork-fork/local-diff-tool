#!/usr/bin/env bash
# review — open a local git repository in the Local Review app (http://localhost:22222).
# Usage: review [path-to-repo] [list-comments | list-comment <comment-id> | clear | help]
# The app itself is started separately with `docker compose up -d` in the app repo.
set -euo pipefail

PORT="${REVIEW_PORT:-22222}"
BASE="http://localhost:${PORT}"

die() { echo "review: $*" >&2; exit 1; }

usage() {
  cat <<'EOF_HELP'
Usage: review [path] [command]

Opens a local git repository in the Local Review app (http://localhost:22222),
or runs a command against its comments. The app must already be running
(docker compose up -d).

Arguments:
  path                  Optional. The repo to use, given as any path inside it. Either:
                          - run review from inside the repo (no path needed), or
                          - pass the repo path: review /abs/path/to/repo [command]
                        The path must come before the command.

Commands (all optional; without one, the repo is opened in the browser):
  list-comments         Print unresolved comments as file:line plus the thread.
  list-comment <id>     Print one comment thread in any state. <id> is required.
  clear                 Delete all comments of the current repo and branch.
  help                  Show this help (also: -h, --help).

Examples:
  review                                      Open the repo you are in
  review /abs/path/to/repo                    Open that repo from anywhere
  review list-comments                        List comments of the repo you are in
  review /abs/path/to/repo list-comments      List comments of that repo
  review /abs/path/to/repo list-comment <id>

Environment:
  REVIEW_PORT           App port (default 22222).
EOF_HELP
}

command -v git >/dev/null || die "git is not installed"
command -v curl >/dev/null || die "curl is not installed"

is_cmd() { case "$1" in list-comments|list-comment|clear|help|-h|--help) return 0 ;; *) return 1 ;; esac; }

target="."
if [ $# -gt 0 ] && ! is_cmd "$1"; then
  [ -e "$1" ] || { echo "review: unknown command or path does not exist: $1" >&2; echo >&2; usage >&2; exit 1; }
  target="$1"; shift
fi
cmd="${1:-}"
case "$cmd" in
  ""|list-comments|clear) ;;
  help|-h|--help) usage; exit 0 ;;
  list-comment) [ -n "${2:-}" ] || { echo "review: list-comment requires a <comment-id>" >&2; echo >&2; usage >&2; exit 1; } ;;
  *) echo "review: unknown command: $cmd" >&2; echo >&2; usage >&2; exit 1 ;;
esac
[ -z "$cmd" ] || [ "$cmd" = clear ] || command -v jq >/dev/null || die "jq is required for $cmd"
[ -e "$target" ] || die "path does not exist: $target"
[ -d "$target" ] || target="$(dirname "$target")"
target="$(cd "$target" 2>/dev/null && pwd -P)" || die "path is not accessible: ${1:-.}"

root="$(git -C "$target" rev-parse --show-toplevel 2>/dev/null)" || die "not a git repository: $target"
root="$(cd "$root" && pwd -P)"

# The app must already be running (docker compose up -d).
if ! curl -fsS --max-time 3 "$BASE/api/health" >/dev/null 2>&1; then
  if command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | grep -q ":${PORT} "; then
    die "port ${PORT} is in use but ${BASE}/api/health did not respond. Is another program using it?"
  fi
  die "the app is not reachable at ${BASE}. Start it with: docker compose up -d (in the local-review app directory)"
fi

json_path="${root//\\/\\\\}"
json_path="${json_path//\"/\\\"}"
resp="$(curl -sS --max-time 20 -w '\n%{http_code}' -H 'Content-Type: application/json' \
  -d "{\"path\":\"${json_path}\"}" "$BASE/api/repositories/open")" || die "could not reach the API at $BASE"
code="${resp##*$'\n'}"
body="${resp%$'\n'*}"
if [ "$code" != "200" ]; then
  msg="$(printf '%s' "$body" | sed -n 's/.*"message":"\([^"]*\)".*/\1/p')"
  die "${msg:-API returned HTTP $code}"
fi
id="$(printf '%s' "$body" | sed -n 's/.*"id":"\([^"]*\)".*/\1/p')"
[ -n "$id" ] || die "unexpected API response: $body"

if [ "$cmd" = clear ]; then
  out="$(curl -sS --max-time 20 -X DELETE -w '\n%{http_code}' "$BASE/api/repositories/$id/comments")" || die "could not reach the API at $BASE"
  code="${out##*$'\n'}"; out="${out%$'\n'*}"
  [ "$code" = 200 ] || die "could not clear comments (HTTP $code)"
  echo "Cleared $(printf '%s' "$out" | sed -n 's/.*"cleared":\([0-9]*\).*/\1/p') comment(s)."
  exit 0
fi

if [ -n "$cmd" ]; then
  fmt='"\(.file):\(.line)\(if .resolved then " [resolved]" else "" end)\(if .outdated then " [outdated]" else "" end)\n  \(.author): \(.body | gsub("\n"; "\n  "))\(.replies | map("\n  \(.author): \(.body | gsub("\n"; "\n  "))") | join(""))"'
  if [ "$cmd" = list-comments ]; then ep="comments"; sel=".comments[]"; else ep="comments/$2"; sel="."; fi
  out="$(curl -sS --max-time 60 -w '\n%{http_code}' "$BASE/api/repositories/$id/$ep")" || die "could not reach the API at $BASE"
  code="${out##*$'\n'}"; out="${out%$'\n'*}"
  [ "$code" = 200 ] || die "$(printf '%s' "$out" | jq -r '.error.message // empty' 2>/dev/null || true)${out:+ (HTTP $code)}"
  printf '%s' "$out" | jq -r "$sel | $fmt"
  exit 0
fi

# On main/master, offer to clear comments older than a week (only when interactive).
if [ -t 0 ]; then
  stats="$(curl -sS --max-time 20 "$BASE/api/repositories/$id/comment-stats" 2>/dev/null || true)"
  branch="$(printf '%s' "$stats" | sed -n 's/.*"branch":"\([^"]*\)".*/\1/p')"
  oldest="$(printf '%s' "$stats" | sed -n 's/.*"oldestCreatedAt":"\([^"]*\)".*/\1/p')"
  if { [ "$branch" = main ] || [ "$branch" = master ]; } && [ -n "$oldest" ]; then
    oldest_s="$(date -d "$oldest" +%s 2>/dev/null || echo 0)"
    if [ "$oldest_s" -gt 0 ] && [ $(( $(date +%s) - oldest_s )) -gt 604800 ]; then
      read -r -p "Comments older than 1 week exist on $branch. Clear all comments? [y/n] " ans || ans=n
      case "$ans" in
        y|Y|yes|YES) curl -fsS --max-time 20 -X DELETE "$BASE/api/repositories/$id/comments" >/dev/null && echo "Cleared comments." || echo "review: failed to clear comments" >&2 ;;
      esac
    fi
  fi
fi

url="$BASE/repositories/$id"
echo "Opening $url"
if command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1 || echo "review: could not launch a browser; open $url manually" >&2
elif command -v open >/dev/null 2>&1; then open "$url" || echo "review: could not launch a browser; open $url manually" >&2
else echo "review: no browser launcher found; open $url manually" >&2; fi
